---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

const courseUrl = 'https://www.skool.com/the-ai-agency-free-resources-9832';
---

<Layout title="Free AI Agency Course" showMetaPixel showChatWidget={false}>
	<main class="min-h-screen px-4 py-12 sm:px-6 lg:px-8">
		<section class="section-container flex min-h-[calc(100vh-6rem)] flex-col items-center justify-center text-center">
			<div class="w-full max-w-4xl">
				<p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-accent">
					Free training
				</p>
				<h1 class="mx-auto max-w-3xl text-4xl font-bold leading-tight text-primary sm:text-5xl lg:text-6xl">
					Enter The AI Agency Free Course
				</h1>

				<div class="glass-card-strong mt-10 overflow-hidden rounded-2xl p-3">
					<div class="flex aspect-video w-full items-center justify-center rounded-xl border border-dashed border-slate-300/80 bg-slate-950/90 text-white shadow-inner">
						<div class="px-6">
							<p class="text-sm font-semibold uppercase tracking-[0.25em] text-orange-200">
								VSL
							</p>
							<p class="mt-3 text-lg font-semibold sm:text-xl">
								Video placeholder
							</p>
						</div>
					</div>
				</div>

				<div class="mt-10 flex flex-col items-center">
					<a class="btn-cta text-lg" href={courseUrl}>
						Enter The Course
					</a>
					<p class="mt-4 text-sm font-medium text-secondary">
						* Approval takes 3-5 business days.
					</p>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
