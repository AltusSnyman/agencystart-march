---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

const courseUrl = '/free-course/upgrade';
const vslShareUrl = 'https://www.loom.com/share/91b0cbd1aaa04a7396c4e082e93e5d0e';
const vslUrl = 'https://www.loom.com/embed/91b0cbd1aaa04a7396c4e082e93e5d0e';
---

<Layout title="Free AI Agency Course" showMetaPixel showChatWidget={false}>
	<main class="min-h-screen px-4 py-12 sm:px-6 lg:px-8">
		<section class="section-container flex min-h-[calc(100vh-6rem)] flex-col items-center justify-center text-center">
			<div class="w-full max-w-4xl">
				<p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-accent">
					Free training
				</p>
				<h1 class="mx-auto max-w-3xl text-4xl font-bold leading-tight text-primary sm:text-5xl lg:text-6xl">
					Enter The AI Agency Free Course
				</h1>

				<div class="glass-card-strong mt-10 overflow-hidden rounded-2xl p-3">
					<iframe
						src={vslUrl}
						class="h-full min-h-[220px] w-full rounded-xl sm:min-h-[360px] lg:min-h-[460px]"
						frameborder="0"
						webkitallowfullscreen
						mozallowfullscreen
						allowfullscreen
						allow="autoplay; fullscreen"
						title="Free AI Agency Course VSL"
					></iframe>
				</div>
				<a
					href={vslShareUrl}
					class="mt-4 inline-flex text-sm font-semibold text-accent hover:underline"
					target="_blank"
					rel="noopener noreferrer"
				>
					Open the VSL video
				</a>

				<div class="mt-10 flex flex-col items-center">
					<a class="btn-cta text-lg" href={courseUrl}>
						Enter The Course
					</a>
					<p class="mt-4 text-sm font-medium text-secondary">
						* Approval takes 3-5 business days.
					</p>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
