---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';

const checkoutUrl = 'https://checkout.aiagencymentorship.ai/';
const freeCourseUrl = 'https://www.skool.com/the-ai-agency-free-resources-9832';

const included = [
	'Grey-label GoHighLevel enterprise license',
	'Unlimited client sub-accounts',
	'No HighLevel branding shown to clients',
	'SaaS mode so you can resell under your brand',
	'400+ AI agency training videos',
	'123 niche-specific snapshots',
	'40+ N8N automation blueprints',
	'5-day agency launch sprint',
	'Skool group, mentorship, and live support',
];

const stats = [
	{ value: '1,297+', label: 'Members saving on software' },
	{ value: '$400/mo', label: 'Instant GoHighLevel savings' },
	{ value: '30 days', label: 'Money-back guarantee' },
];
---

<Layout title="Before You Enter The Free Course" showMetaPixel showChatWidget={false}>
	<main>
		<section class="relative overflow-hidden px-4 py-16 sm:px-6 lg:px-8">
			<div class="absolute inset-0 z-0 bg-gradient-to-b from-slate-950 via-slate-900 to-blue-950"></div>
			<div class="absolute left-1/2 top-0 z-[1] h-[420px] w-[900px] -translate-x-1/2 rounded-full bg-blue-500/20 blur-3xl"></div>
			<div class="absolute bottom-0 left-0 right-0 z-[1] h-28 bg-gradient-to-b from-transparent to-[#EEF2FF]"></div>

			<div class="relative z-10 mx-auto max-w-5xl text-center">
				<p class="mb-5 inline-flex rounded-full border border-white/15 bg-white/10 px-5 py-2 text-sm font-semibold text-orange-200 backdrop-blur">
					Congratulations, your free course is ready
				</p>
				<h1 class="mx-auto max-w-4xl text-4xl font-bold leading-tight text-white sm:text-5xl lg:text-6xl">
					Before You Enter... Save <span class="text-orange-400">$400/mo</span> On GoHighLevel
				</h1>
				<p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-slate-300 sm:text-xl">
					You are about to receive the free course material. But before you go, understand this:
					software subscriptions are expensive. Get the GoHighLevel stack for $97/mo instead of
					$497/mo, create unlimited accounts, and keep building inside the Skool group.
				</p>

				<div class="mt-10 flex flex-col items-center">
					<a href={checkoutUrl} class="btn-cta px-10 py-5 text-lg">
						Yes, Save $400/mo On GoHighLevel
					</a>
					<a
						href={freeCourseUrl}
						class="mt-5 text-sm font-semibold text-slate-300 underline decoration-white/30 underline-offset-4 hover:text-white"
					>
						No thanks, I'll miss out and only get the free course
					</a>
				</div>

				<div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-3">
					{stats.map((stat) => (
						<div class="rounded-2xl border border-white/15 bg-white/10 p-5 backdrop-blur">
							<p class="text-3xl font-bold text-white">{stat.value}</p>
							<p class="mt-1 text-sm text-slate-300">{stat.label}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="section-padding bg-white">
			<div class="section-container">
				<h2 class="section-title">The Free Course Shows You The Path. This Gives You The Stack.</h2>
				<p class="section-subtitle">
					Most people get stuck before they ever land a client because the tools alone are too expensive.
				</p>

				<div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
					<div class="glass-card p-8">
						<h3 class="mb-6 text-2xl font-bold">Doing It Alone</h3>
						<div class="space-y-4">
							<div class="flex justify-between border-b border-slate-100 pb-3">
								<span>GoHighLevel enterprise plan</span>
								<span class="font-bold text-red-500">$497/mo</span>
							</div>
							<div class="flex justify-between border-b border-slate-100 pb-3">
								<span>Automation tools</span>
								<span class="font-bold text-red-500">$100+/mo</span>
							</div>
							<div class="flex justify-between border-b border-slate-100 pb-3">
								<span>Training, snapshots, and setup help</span>
								<span class="font-bold text-red-500">$200+/mo</span>
							</div>
							<div class="flex justify-between pt-2 text-xl font-bold text-red-600">
								<span>Total before your first client</span>
								<span>$800+/mo</span>
							</div>
						</div>
					</div>

					<div class="glass-card p-8">
						<h3 class="mb-6 text-2xl font-bold">With AI Agency Mentorship</h3>
						<div class="rounded-2xl bg-green-50 p-6 text-center">
							<p class="text-sm font-semibold uppercase tracking-[0.18em] text-green-700">
								Founder's rate
							</p>
							<p class="mt-2 text-6xl font-bold text-green-700">$97</p>
							<p class="text-lg font-semibold text-green-800">per month</p>
							<p class="mt-3 text-sm text-green-700">Save $400/mo instantly on GoHighLevel alone</p>
						</div>
						<p class="mt-6 text-center text-secondary">
							Unlimited sub-accounts, grey-label setup, training, snapshots, automation blueprints,
							and community support included.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="section-padding" style="background: linear-gradient(180deg, #EEF2FF 0%, #F8FAFC 100%);">
			<div class="mx-auto max-w-4xl px-4">
				<div class="text-center">
					<span class="mb-6 inline-flex rounded-full bg-accent/10 px-4 py-2 text-sm font-semibold text-accent">
						Upgrade before you enter
					</span>
					<h2 class="section-title">Everything You Need To Build With GoHighLevel</h2>
					<p class="section-subtitle">
						This is the shortcut: the software, the setup path, and the community in one place.
					</p>
				</div>

				<div class="glass-card-strong p-6 sm:p-8">
					<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
						{included.map((item) => (
							<div class="flex items-start gap-3 rounded-xl bg-white/60 p-4">
								<div class="mt-0.5 flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-green-100">
									<svg class="h-3.5 w-3.5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
										<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
									</svg>
								</div>
								<p class="font-medium text-primary">{item}</p>
							</div>
						))}
					</div>

					<div class="mt-8 rounded-2xl bg-accent/5 p-6 text-center">
						<p class="text-sm font-medium text-secondary">Normal software cost: <span class="line-through">$497/mo</span></p>
						<p class="mt-2 text-4xl font-bold text-accent">$97/mo today</p>
						<p class="mt-2 text-sm font-semibold text-green-600">Cancel anytime. 30-day money-back guarantee.</p>
					</div>
				</div>
			</div>
		</section>

		<section class="section-padding bg-white">
			<div class="mx-auto max-w-3xl text-center">
				<h2 class="section-title">The Smart Move Is To Start With The Right Stack</h2>
				<p class="section-subtitle">
					You can still take the free course. This page is simply your chance to lock in the software
					advantage before you start learning what to build.
				</p>

				<div class="glass-card p-8">
					<svg class="mx-auto mb-4 h-12 w-12 text-accent" fill="none" viewBox="0 0 48 48" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M24 4L6 12v12c0 11.1 7.8 21.5 18 24 10.2-2.5 18-12.9 18-24V12L24 4z" />
						<path stroke-linecap="round" stroke-linejoin="round" d="M17 24l5 5 9-9" />
					</svg>
					<h3 class="text-2xl font-bold">Try it with a 30-day guarantee</h3>
					<p class="mx-auto mt-3 max-w-xl text-secondary">
						Join today, follow the setup steps, and if the membership is not right for you, request a
						refund within 30 days.
					</p>
				</div>

				<div class="mt-10 flex flex-col items-center">
					<a href={checkoutUrl} class="btn-cta px-10 py-5 text-lg">
						Yes, I Want To Save $400/mo
					</a>
					<a
						href={freeCourseUrl}
						class="mt-5 text-sm font-semibold text-secondary underline underline-offset-4 hover:text-primary"
					>
						No thanks, I'll miss out and only get the free course
					</a>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
